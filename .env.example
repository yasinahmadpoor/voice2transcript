GEMINI_API_KEY=your-gemini-api-key
# Run python setup_login.py to add APP_USERNAME and APP_PASSWORD_HASH to .env.
# Set true when serving through HTTPS.
SECURE_COOKIES=false
MAX_UPLOAD_MB=500
TRANSCRIPTION_WORKERS=2
MAX_PENDING_JOBS=20
# Local runs use ./data; Docker persists /app/data in a named volume.
# JOB_DATA_DIR=./data
