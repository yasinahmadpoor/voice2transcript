GEMINI_API_KEY=your-gemini-api-key
# After migrations, run uv run --locked python manage.py createsuperuser for the initial administrator.
# Existing APP_USERNAME / APP_PASSWORD_HASH credentials are imported once on upgrade.
# Set true when serving through HTTPS.
SECURE_COOKIES=false
MAX_UPLOAD_MB=500
TRANSCRIPTION_WORKERS=2
MAX_PENDING_JOBS=20
# Comma-separated hostnames/IPs, without schemes or ports; add your deployment host.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Optional signing key. Otherwise one is generated and persisted inside JOB_DATA_DIR.
# DJANGO_SECRET_KEY=generate-a-long-random-value
# If using a reverse proxy, trust only its source IPs (never a public wildcard).
# FORWARDED_ALLOW_IPS=127.0.0.1,::1
# Local runs use ./data; Docker persists /app/data in a named volume.
# JOB_DATA_DIR=./data
